{
  // Node 24 base + the workspace's shared strictness/module core
  // (root tsconfig.base.json). Array order: later wins, so the shared core
  // layers on top of @tsconfig/node24. Deliberately not on @tsconfig/node26:
  // its es2025 target/lib needs a TypeScript major we haven't adopted yet
  // (see the Node 26 upgrade). Node 26 runs es2024-target output fine, so the
  // compile target and the runtime version are free to move independently.
  "extends": [
    "@tsconfig/node24/tsconfig.json",
    "../tsconfig.base.json"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": [
      "node",
    ],
    "paths": {
      "#utils/*": ["./src/utils/*.ts"],
      "#config/*": ["./src/config/*.ts"],
      "#lib/database": ["./src/lib/database/index.ts"],
      "#lib/*": ["./src/lib/*.ts"],
      "#decorators/*": ["./src/decorators/*.ts"],
      "#repositories/*": ["./src/repositories/*.ts"],
      "#services/*": ["./src/services/*.ts"],
      "#shared/*": ["../shared/*.d.ts"]
    },
  },
  "include": [
    "./src/**/*",
    "./scripts/**/*",
    "./test/container-test/**/*"
  ],
  "exclude": [
    "./node_modules/**/*",
    "./test/container-test/node_modules/**/*"
  ]
}
