{
  "name": "demo-platform",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/justinl-y/demo-platform#readme",
  "bugs": {
    "url": "https://github.com/justinl-y/demo-platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinl-y/demo-platform.git"
  },
  "private": true,
  "license": "ISC",
  "author": "Justin Levett-Yeats",
  "type": "module",
  "engines": {
    "npm": ">=11.6.0 <12.0.0",
    "node": ">=26.0.0 <27.0.0"
  },
  "workspaces": [
    "app-demo",
    "api-demo",
    "db-demo",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "openapi:sync": "npm run openapi:generate -w api-demo && npm run openapi:types -w app-demo",
    "lock:refresh": "docker run --rm -v \"$PWD\":/app -w /app node:26-alpine sh -c 'npm install --package-lock-only --legacy-peer-deps'",
    "prepare": "command -v git >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.36.0",
    "eslint-plugin-import-x": "^4.17.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "neostandard": "^0.13.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
