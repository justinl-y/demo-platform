{
  /* Strictness/module core is shared via the root tsconfig.base.json. */
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "es2023",

    /* Additional front-end strictness (kept from the Vite template) */
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
