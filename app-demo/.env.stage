# Loaded by `npm run build` (`vite build --mode stage`) — the S3 + CloudFront deploy (.github/workflows/deploy-s3.yml).
# Stage deployment: the app at demo-stage.discovered-check.ca calls the stage API. Same registrable
# domain (discovered-check.ca), so the SameSite=Lax auth cookies are sent cross-subdomain; the stage
# API's CORS already allow-lists the app origin.
VITE_API_URL=https://api-demo-live-stage.discovered-check.ca

# Sentry (front-end error + performance monitoring). The DSN is a public client credential — safe
# to commit. env:test omits it (Sentry off there); env:local (.env.development) also carries it.
VITE_SENTRY_DSN=https://f744112239208b43d99641889a7ab822@o4510897005854720.ingest.us.sentry.io/4511691108122624
VITE_SENTRY_ENVIRONMENT=STAGE
