{
  "name": "app-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "User interface for the demo platform project",
  "license": "ISC",
  "author": "Justin Levett-Yeats",
  "engines": {
    "npm": ">=11.6.0 <12.0.0",
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "preenv": "lsof -ti tcp:5173 -sTCP:LISTEN | xargs kill 2>/dev/null || true",
    "env:local": "npm run preenv && vite",
    "env:test": "npm run preenv && vite --mode test",
    "build": "tsc -b && vite build --mode stage",
    "typecheck": "tsc -b",
    "openapi:types": "openapi-typescript ../shared/openapi.json -o test/mocks/openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "css:types": "tcm src -p '**/*.module.css'",
    "css:types:watch": "tcm src -p '**/*.module.css' --watch",
    "css:types:ci": "tcm src -p '**/*.module.css' -l",
    "lint": "eslint . --config eslint.config.ts",
    "lint-fix": "eslint . --fix --config eslint.config.ts",
    "preview": "vite preview"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": "eslint --config eslint.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@sentry/react": "^10.63.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "antd": "^6.5.0",
    "axios": "^1.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@mswjs/source": "^0.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "openapi-msw": "^2.0.0",
    "openapi-typescript": "^7.13.0",
    "typed-css-modules": "^0.9.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
